@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (!User.Identity.IsAuthenticated)
{
    Context.Response.Redirect("/Account/Login"); // Change the path based on your login route
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@model Theam.Models.DashBoardViewModel

<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->
    <div class="flex-grow-1 container-p-y">
        <div class="row">
            <div class="container">
                <div class="row">
                    @foreach (var metric in Model.Counts)
                    {
                        string icon = metric.Metric switch
                        {
                            "TotalUser" => "group.png",
                            "TotalOrders" => "cargo.png",
                            "TotalPendingOrders" => "order-history.png",
                            "TotalConfirmOrders" => "bag.png",
                            "TotalPendingReservation" => "restaurant.png",
                            "TotalConfirmReservation" => "delivery-man.png",
                            "TotalAvailableTable" => "dining-room.png",
                            "TotalConfirmTable" => "reserved.png",
                            _ => "default.png"
                        };

                        <div class="col-lg-3 col-md-3 col-sm-4 col-6 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="card-title d-flex align-items-start justify-content-between mb-4">
                                        <div class="avatar flex-shrink-0">
                                            <img src="~/assets/img/icons/unicons/@icon" alt="@metric.Metric" class="rounded" />
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn p-0" type="button" data-bs-toggle="dropdown">
                                                <i class="bx bx-dots-vertical-rounded text-muted"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a class="dropdown-item" href="#">View More</a>
                                                <a class="dropdown-item" href="#">Delete</a>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="mb-1">@metric.Metric.Replace("Total", " ")</p>
                                    <h4 class="card-title mb-3">@metric.Value</h4>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Product List Table -->
        <div class="card">
            <div class="row justify-content-between">
                <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto">
                    <div class="dt-search m-2 mt-5">
                        <input type="search" class="form-control ms-0" id="dt-search-0" placeholder="Search Inventory Item" aria-controls="DataTables_Table_0" onkeyup="filterTable()">
                        <label for="dt-search-0"></label>
                    </div>
                </div>
                <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto px-3 mt-0">
                    <div class="d-flex justify-content-end p-1 align-items-center">
                        <button class="btn btn-primary d-flex justify-content-center" data-bs-toggle="modal" data-bs-target="#addInventoryItemModal">
                            <i class="bx bx-plus"></i> Add Inventory Item
                        </button>
                    </div>
                </div>

                <div class="justify-content-between dt-layout-table">
                    <div class="d-md-flex justify-content-between align-items-center dt-layout-full table-responsive">
                        <table class="table table-striped table-bordered table-hover text-center">
                            <thead class="table-dark">
                            <tr>
                                <th>Inventory Item</th>
                                <th class="text-center">Available Count</th>
                                <th class="text-center">Wanted Count</th>
                                <th class="cell-fit">Actions</th>
                            </tr>
                            </thead>
                            <tbody id="inventoryTableBody">
                            @foreach (var item in Model.Inventory)
                            {
                                <tr>
                                    <td class="sorting_1">
                                        <div class="d-flex justify-content-start align-items-center product-name">
                                            <div class="avatar-wrapper">
                                                <div class="avatar avatar me-2 me-sm-4 rounded-2 bg-label-secondary">
                                                    <img src="@item.ImageURl" alt="Product Image" class="rounded">
                                                </div>
                                            </div>
                                            <h6 class="text-nowrap mb-0">@item.ItemName</h6>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.QuantityAvailable</td>
                                    <td class="@(item.QuantityWanted > 0 ? "text-danger text-center" : "text-center")">@item.QuantityWanted</td>
                                    <td>
                                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editInventoryItemModal"
                                                onclick="openEditModal('@item.InventoryID', '@item.ItemName', '@item.QuantityAvailable', '@item.QuantityWanted', '@item.ImageURl')">
                                            Edit
                                        </button>
                                        <form method="post" asp-action="DeleteInventoryItem" onsubmit="return confirm('Are you sure?')" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.InventoryID" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Inventory Item Modal with Bootstrap Validation -->
    <div class="modal fade" id="addInventoryItemModal" tabindex="-1" aria-labelledby="addInventoryItemModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Inventory Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate asp-action="AddInventoryItem" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="ItemName" class="form-label">Item Name</label>
                            <input type="text" name="ItemName" class="form-control" id="ItemName" required>
                            <div class="invalid-feedback">
                                Please provide an item name.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="QuantityAvailable" class="form-label">Quantity Available</label>
                            <input type="number" name="QuantityAvailable" class="form-control" id="QuantityAvailable" required>
                            <div class="invalid-feedback">
                                Please enter the available quantity.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="QuantityWanted" class="form-label">Quantity Wanted</label>
                            <input type="number" name="QuantityWanted" class="form-control" id="QuantityWanted" required>
                            <div class="invalid-feedback">
                                Please enter the wanted quantity.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="ImageURL" class="form-label">Upload Image</label>
                            <input type="file" name="ImageURL" class="form-control" id="ImageURL" required>
                            <div class="invalid-feedback">
                                Please upload an image.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Add Inventory Item</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Inventory Item Modal with Bootstrap Validation -->
    <div class="modal fade" id="editInventoryItemModal" tabindex="-1" aria-labelledby="editInventoryItemModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Inventory Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate asp-action="UpdateInventoryItem" method="post" enctype="multipart/form-data">
                        <input type="hidden" id="editInventoryID" name="InventoryID">
                        <!-- Hidden input to hold the current image URL -->
                        <input type="hidden" id="editImagePath" name="ImageURL">

                        <div class="mb-3">
                            <label for="editItemName" class="form-label">Item Name</label>
                            <input type="text" id="editItemName" name="ItemName" class="form-control" required>
                            <div class="invalid-feedback">
                                Please provide an item name.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editQuantityAvailable" class="form-label">Quantity Available</label>
                            <input type="number" id="editQuantityAvailable" name="QuantityAvailable" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter the available quantity.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editQuantityWanted" class="form-label">Quantity Wanted</label>
                            <input type="number" id="editQuantityWanted" name="QuantityWanted" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter the wanted quantity.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Current Image</label>
                            <img id="editCurrentImage" src="" alt="Inventory Item Image" style="width: 100px; height: auto;">
                        </div>
                        <div class="mb-3">
                            <label for="editImageURL" class="form-label">Upload New Image (Optional)</label>
                            <!-- File input renamed to "Image" to bind with IFormFile -->
                            <input type="file" name="Image" class="form-control" id="editImageURL">
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- / Content -->
    <div class="content-backdrop fade"></div>
</div>

<!-- Custom Scripts -->
<script>
    function openEditModal(inventoryId, itemName, quantityAvailable, quantityWanted, imageUrl) {
        document.getElementById("editInventoryID").value = inventoryId;
        document.getElementById("editItemName").value = itemName;
        document.getElementById("editQuantityAvailable").value = quantityAvailable;
        document.getElementById("editQuantityWanted").value = quantityWanted;
        document.getElementById('editCurrentImage').src = imageUrl;
        // Set the current image URL in the hidden field
        document.getElementById('editImagePath').value = imageUrl;

        var editModal = new bootstrap.Modal(document.getElementById('editInventoryItemModal'));
        editModal.show();
    }


    // Filter table function for inventory items
    function filterTable() {
        let input = document.getElementById("dt-search-0").value.toLowerCase();
        let rows = document.querySelectorAll("#inventoryTableBody tr");

        rows.forEach(row => {
            let itemName = row.querySelector(".product-name h6").textContent.toLowerCase();
            row.style.display = itemName.includes(input) ? "" : "none";
        });
    }

    // Bootstrap form validation
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
